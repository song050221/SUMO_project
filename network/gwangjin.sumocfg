<configuration>
    <input>
        <net-file value="gwangjin.net.xml"/>
        <route-files value="routes.xml,pedestrian_routes.xml"/>
        <additional-files value="gwangjin_styled.poly.xml,vehicle_style.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <processing>
        <collision.action value="warn"/>
        <collision.check-junctions value="true"/>
        <collision.mingap-factor value="0"/>
        <intermodal-collision.action value="warn"/>
    </processing>
    <output>
        <collision-output value="collisions.xml"/>
    </output>
</configuration>
